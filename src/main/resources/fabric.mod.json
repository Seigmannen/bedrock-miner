{
	"schemaVersion": 1,
	"id": "bedrock-miner",
	"version": "${version}",
	"name": "Bedrock Miner",
	"description": "Lets a netherite pickaxe mine bedrock, including the bottom layer of the Overworld. Takes 2 minutes, sped up by Efficiency and Haste, and the bedrock drops as a block.",
	"authors": [
		"seigmannen"
	],
	"contact": {
		"homepage": "https://github.com/Seigmannen/bedrock-miner",
		"sources": "https://github.com/Seigmannen/bedrock-miner"
	},
	"license": "MIT",
	"icon": "assets/bedrock-miner/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.seigmannen.bedrockminer.BedrockMiner"
		],
		"client": [
			"com.seigmannen.bedrockminer.client.BedrockMinerClient"
		]
	},
	"mixins": [
		"bedrock-miner.mixins.json",
		{
			"config": "bedrock-miner.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}